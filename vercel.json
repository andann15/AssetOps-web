{
  "version": 2,
  "buildCommand": "echo 'Build skipped - assets pre-built'",
  "installCommand": "composer install --optimize-autoloader 2>/dev/null || echo 'Composer done'",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
